#ifndef MACMTP_LIBMTP_CONFIG_H
#define MACMTP_LIBMTP_CONFIG_H

/* Darwin configuration normally generated by libmtp's configure script. */
#define HAVE_ICONV 1
#define HAVE_LANGINFO_H 1
#define HAVE_LIBUSB1 1
#define HAVE_LIMITS_H 1
#define HAVE_MKSTEMP 1
#define HAVE_STRNDUP 1
#define HAVE_SYS_UIO_H 1
#define HAVE_UNISTD_H 1
#define PACKAGE "libmtp"
#define PACKAGE_NAME "libmtp"
#define PACKAGE_STRING "libmtp @LIBMTP_SOURCE_VERSION@"
#define PACKAGE_VERSION "@LIBMTP_SOURCE_VERSION@"
#define VERSION "@LIBMTP_SOURCE_VERSION@"
#define USE_DARWIN 1

#endif
